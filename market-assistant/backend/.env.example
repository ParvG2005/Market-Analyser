# Copy to .env for local development and fill in real values.

# Deployment environment: "dev" | "test" | "prod".
# REQUIRED for local runs: the config default is "prod" (fail-closed auth), so
# leaving ENV unset disables the X-Dev-User dev auth stub. Set ENV=dev locally.
# The test suite pins ENV=test (tests/conftest.py). Never set ENV=dev/test in prod.
ENV=dev

# Postgres (async driver required for the app engine).
DATABASE_URL=postgresql+asyncpg://market:market@localhost:5434/market_assistant
REDIS_URL=redis://localhost:6379/0

# --- Auth (Supabase JWT verification) ---
JWT_SECRET=                 # HS256 shared secret (Supabase legacy / local / tests)
JWT_ISSUER=                 # expected iss; "" disables the iss check
JWT_AUDIENCE=authenticated  # Supabase user-token aud
SUPABASE_URL=               # https://<ref>.supabase.co
SUPABASE_JWKS_URL=          # if set, verify RS256/ES256 via JWKS instead of HS256

# --- Chat assistant (Phase 10) — pick ONE provider and set its key ---
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=

# --- Hardening / alerts (Phase 11) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
